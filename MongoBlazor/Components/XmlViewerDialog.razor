    private string FormatXml(string xml)
    {
        if (string.IsNullOrWhiteSpace(xml) || xml == "No data available" || xml.Contains("No ") && xml.Contains(" XML available"))
            return xml;

        try
        {
            // Parse and format XML with indentation
            var doc = XDocument.Parse(xml);
            var formatted = doc.ToString();

            // Apply syntax highlighting
            return ApplySyntaxHighlighting(formatted);
        }
        catch
        {
            // If XML parsing fails, return as-is
            return System.Net.WebUtility.HtmlEncode(xml);
        }
    }

    private string ApplySyntaxHighlighting(string xml)
    {
        // Escape HTML first
        xml = System.Net.WebUtility.HtmlEncode(xml);

        // Highlight XML tags
        xml = System.Text.RegularExpressions.Regex.Replace(xml,
            @"&lt;(/?)(\w+)",
            match => $"&lt;<span class='xml-tag'>{match.Groups[1].Value}{match.Groups[2].Value}</span>");

        // Highlight closing tag bracket
        xml = System.Text.RegularExpressions.Regex.Replace(xml,
            @"(/?)&gt;",
            match => $"<span class='xml-tag'>{match.Groups[1].Value}&gt;</span>");

        // Highlight attributes
        xml = System.Text.RegularExpressions.Regex.Replace(xml,
            @"(\w+)=",
            match => $"<span class='xml-attribute'>{match.Groups[1].Value}</span>=");

        // Highlight attribute values
        xml = System.Text.RegularExpressions.Regex.Replace(xml,
            @"&quot;([^&quot;]*)&quot;",
            match => $"<span class='xml-attribute-value'>&quot;{match.Groups[1].Value}&quot;</span>");

        // Highlight comments
        xml = System.Text.RegularExpressions.Regex.Replace(xml,
            @"&lt;!--(.*)--&gt;",
            match => $"<span class='xml-comment'>&lt;!--{match.Groups[1].Value}--&gt;</span>");

        return xml;
    }

    private void Close() => MudDialog?.Close();

    private void CopyToClipboard()
    {
        MudDialog?.Close();
    }
