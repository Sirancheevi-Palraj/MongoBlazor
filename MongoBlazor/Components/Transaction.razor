@page "/transactions"
@* @rendermode InteractiveServer *@
@using MongoBlazor.Model
@using MongoBlazor.Services
@using MudBlazor
@inject TransactionService TransactionService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IDialogService DialogService

<MudPaper Class="pa-4" Style="max-width:1400px;margin:auto;">
    <MudCard Class="pa-3 mb-3">

        <!-- TOOLBAR -->
        <MudStack Row Spacing="2" AlignItems="AlignItems.Center">

            @* <MudText Typo="Typo.h5" Class="fw-bold">Transaction Monitor</MudText> *@

            <MudSpacer />

            <MudTextField @bind-Value="_search"
                          Placeholder="Search Tracking Id"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Class="w-300" />

            <MudSelect T="string" @bind-Value="_filterStatus" Label="Status" Class="w-200">
                <MudSelectItem Value="@("All")">All</MudSelectItem>
                <MudSelectItem Value="@("SUCCESS")">Success</MudSelectItem>
                <MudSelectItem Value="@("FAILURE")">Failure</MudSelectItem>
            </MudSelect>

   @*          <MudDatePicker @bind-Date="_startDate"
                           Label="Start Date"
                           DateFormat="dd-MMM-yyyy"
                           Clearable="true"
                           Class="w-200" />

            <MudDatePicker @bind-Date="_endDate"
                           Label="End Date"
                           DateFormat="dd-MMM-yyyy"
                           Clearable="true"
                           Class="w-200" /> *@
            <!-- SINGLE DATE + TIME CONTROLS -->
            <MudTextField @bind-Value="_startDateTimeLocal"
                          Label="Start Date & Time"
                          InputType="InputType.DateTimeLocal"
                          Clearable="true"
                          Class="w-300" />

            <MudTextField @bind-Value="_endDateTimeLocal"
                          Label="End Date & Time"
                          InputType="InputType.DateTimeLocal"
                          Clearable="true"
                          Class="w-300" />
            <MudIconButton Icon="@Icons.Material.Filled.Settings"
                           Color="Color.Primary"
                           OnClick="OpenColumnSettings" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyFilter">Apply</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ClearFilter">Reset</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Success" OnClick="DownloadExcel">Export</MudButton>

        </MudStack>
    </MudCard>

    <MudText Typo="Typo.subtitle2" Class="mb-1">
        Total Records: @_totalCount
    </MudText>

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
    }

    <!-- DATA GRID -->
    <MudTable T="TransactionData"
              @ref="_table"
              ServerData="LoadServerData"
              Dense="true"
              Hover="true"
              Bordered="true"
              Striped="true"
              FixedHeader="true"
              RowsPerPage="20"
              Breakpoint="Breakpoint.Sm">

        <HeaderContent>
            @if (IsVisible("TrackingId"))
            {
                <MudTh>Tracking Id</MudTh>
            }
            @if (IsVisible("Status"))
            {
                <MudTh>Status</MudTh>
            }
            @if (IsVisible("RequestDateTime"))
            {
                <MudTh>Request Time</MudTh>
            }
            @if (IsVisible("ResponseDateTime"))
            {
                <MudTh>Response Time</MudTh>
            }
            @if (IsVisible("TimeTaken"))
            {
                <MudTh>Time Taken</MudTh>
            }
            @if (IsVisible("Timestamp"))
            {
                <MudTh>Created</MudTh>
            }
            @if (IsVisible("Message"))
            {
                <MudTh>Message</MudTh>
            }
        </HeaderContent>

        <RowTemplate Context="x">
            @if (IsVisible("TrackingId"))
            {
                <MudTd>@x.TrackingId</MudTd>
            }

            @if (IsVisible("Status"))
            {
                <MudTd>
                    <MudChip T="string"
                             Color="@(x.Status=="SUCCESS" ? Color.Success : Color.Error)"
                             Variant="Variant.Filled"
                             Size="Size.Small">
                        @x.Status
                    </MudChip>
                </MudTd>
            }

            @if (IsVisible("RequestDateTime"))
            {
                <MudTd>@x.RequestDateTime</MudTd>
            }
            @if (IsVisible("ResponseDateTime"))
            {
                <MudTd>@x.ResponseDateTime</MudTd>
            }
            @if (IsVisible("TimeTaken"))
            {
                <MudTd>0</MudTd>
            }
            @if (IsVisible("Timestamp"))
            {
                <MudTd>@x.Timestamp</MudTd>
            }
            @if (IsVisible("Message"))
            {
                <MudTd>@x.Message</MudTd>
            }
        </RowTemplate>

        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>

</MudPaper>

@code {
    private List<TransactionData> _allRecords = new();
    private List<TransactionData> _filteredRecords = new();
    private int _totalCount;
    private DateTime? _startDate;
    private DateTime? _endDate;
    private string _search = "";
    private string _filterStatus = "All";
    private bool _isLoading = true;
    private string? _startDateTimeLocal;
    private string? _endDateTimeLocal;
    private MudTable<TransactionData> _table;

    private const string StorageKey = "transaction_columns_v1";
    private List<ColumnSetting> _columns = new()
{
    new() { Key="TrackingId", Title="Tracking Id", Visible=true },
    new() { Key="Status", Title="Status", Visible=true },
    new() { Key="RequestDateTime", Title="Request Time", Visible=true },
    new() { Key="ResponseDateTime", Title="Response Time", Visible=true },
    new() { Key="TimeTaken", Title="Time Taken", Visible=true },
    new() { Key="Timestamp", Title="Created", Visible=true },
    new() { Key="Message", Title="Message", Visible=true }
};


    protected override async Task OnInitializedAsync()
    {
        await LoadData(); // Load data without localStorage first
    }
    // protected override async Task OnAfterRenderAsync(bool firstRender)
    // {
    //     // if (firstRender)
    //     // {
    //     //     await LoadColumnSettings();
    //     //     StateHasChanged(); // refresh UI with loaded column settings
    //     // }
    // }

    private bool IsVisible(string key)
    {
        return _columns?.FirstOrDefault(c => c.Key == key)?.Visible ?? true;
    }

    private void MapDateTimeLocalToDateTime()
    {
        _startDate = DateTime.TryParse(_startDateTimeLocal, out var start)
            ? start
            : null;

        _endDate = DateTime.TryParse(_endDateTimeLocal, out var end)
            ? end
            : null;
    }

    private async Task LoadData()
    {
        try
        {
            _isLoading = true;
            
            
            StateHasChanged();

            // Load data from database with filters applied on server
            (var data, var total) = await TransactionService.GetTransactionsAsync(
                search: string.IsNullOrWhiteSpace(_search) ? null : _search,
                start: _startDate,
                end: _endDate,
                status: _filterStatus,
                page: 1,
                pageSize: 1000, // Load more records
                sortField: "RequestDateTime",
                sortDesc: true
            );

            _allRecords = data;
            _filteredRecords = data;
            _totalCount = total;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading data: {ex.Message}", Severity.Error);
            _allRecords = new List<TransactionData>();
            _filteredRecords = new List<TransactionData>();
            _totalCount = 0;
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ApplyFilter()
    {
        // Reload data from server with current filters
        MapDateTimeLocalToDateTime();   // 🔥 IMPORTANT

        await _table.ReloadServerData();
    }
    private async Task<TableData<TransactionData>> LoadServerData(TableState state, CancellationToken token)
    {
        try
        {
            _isLoading = true;

            // Map UI datetime-local to DateTime
            MapDateTimeLocalToDateTime();

            int page = state.Page + 1; // MudTable page starts from 0
            int pageSize = state.PageSize;

            (var data, var total) = await TransactionService.GetTransactionsAsync(
                search: string.IsNullOrWhiteSpace(_search) ? null : _search,
                start: _startDate,
                end: _endDate,
                status: _filterStatus,
                page: page,
                pageSize: pageSize,
                sortField: "RequestDateTime",
                sortDesc: true
            );

            _totalCount = total;

            return new TableData<TransactionData>()
            {
                Items = data,
                TotalItems = total
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading data: {ex.Message}", Severity.Error);

            return new TableData<TransactionData>()
            {
                Items = new List<TransactionData>(),
                TotalItems = 0
            };
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }


    private void ApplyClientSideFilter()
    {
        // Not needed anymore - filtering is done on server
    }

    private async Task ClearFilter()
    {
        _search = "";
        _filterStatus = "All";
        _startDate = null;
        _endDate = null;

        // Reload data without filters
        await _table.ReloadServerData();
    }

    private void OpenDialog(TransactionData item, string title)
    {
        var parameters = new DialogParameters
        {
            ["Transaction"] = item,
            ["XmlType"] = title
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true,
            CloseButton = true
        };

        DialogService.Show<XmlViewerDialog>("Transaction XML Details", parameters, options);
    }

    private async Task DownloadExcel()
    {
        try
        {
            _isLoading = true;
            StateHasChanged();

            // Use current filtered data for export
            var rows = await TransactionService.GetAllForExportAsync(
                string.IsNullOrWhiteSpace(_search) ? null : _search,
                _startDate,
                _endDate,
                _filterStatus);

            if (rows == null || rows.Count == 0)
            {
                Snackbar.Add("No data to export", Severity.Warning);
                return;
            }

            using var wb = new ClosedXML.Excel.XLWorkbook();
            var ws = wb.Worksheets.Add("Transactions");

            // Headers
            ws.Cell(1, 1).Value = "No";
            ws.Cell(1, 2).Value = "TrackingId";
            ws.Cell(1, 3).Value = "Status";
            ws.Cell(1, 4).Value = "RequestDateTime";
            ws.Cell(1, 5).Value = "ResponseDateTime";
            ws.Cell(1, 6).Value = "TimeTaken";
            ws.Cell(1, 7).Value = "CreatedDate";
            ws.Cell(1, 8).Value = "Message";

            // Style header row
            var headerRow = ws.Row(1);
            headerRow.Style.Font.Bold = true;
            headerRow.Style.Fill.BackgroundColor = ClosedXML.Excel.XLColor.LightGray;

            // Data rows
            for (int i = 0; i < rows.Count; i++)
            {
                var r = rows[i];
                ws.Cell(i + 2, 1).Value = i + 1;
                ws.Cell(i + 2, 2).Value = r.TrackingId ?? "";
                ws.Cell(i + 2, 3).Value = r.Status ?? "";
                ws.Cell(i + 2, 4).Value = r.RequestDateTime.ToString("dd-MMM-yyyy HH:mm:ss");
                ws.Cell(i + 2, 5).Value = r.ResponseDateTime?.ToString("dd-MMM-yyyy HH:mm:ss") ?? "";
                ws.Cell(i + 2, 6).Value = r.TimeTaken.ToString(@"hh\:mm\:ss");
                ws.Cell(i + 2, 7).Value = r.Timestamp.ToString("dd-MMM-yyyy HH:mm:ss");
                ws.Cell(i + 2, 8).Value = r.Message ?? "";
            }

            // Auto-fit columns
            ws.Columns().AdjustToContents();

            using var ms = new MemoryStream();
            wb.SaveAs(ms);
            var bytes = ms.ToArray();
            var base64 = Convert.ToBase64String(bytes);

            await JS.InvokeVoidAsync("downloadFileFromStream",
                $"Transactions_{DateTime.Now:yyyyMMddHHmmss}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                base64);

            Snackbar.Add($"Exported {rows.Count} records successfully", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Export failed: {ex.Message}", Severity.Error);
            Console.WriteLine($"Export error: {ex}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }
    private async Task OpenColumnSettings()
    {
        // ✅ Ensure popup always shows latest saved values
        await ApplyLocalStorageColumnSettings();

        var parameters = new DialogParameters
        {
            ["Columns"] = _columns
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            FullWidth = true,
            MaxWidth = MaxWidth.Small
        };

        var dialog = DialogService.Show<ColumnSettingsDialog>("Column Settings", parameters, options);

        var result = await dialog.Result;

        if (!result.Canceled)
        {
            // ✅ Save updated values after apply
           // await SaveColumnSettings();
            StateHasChanged();
        }
    }

    private async Task ApplyLocalStorageColumnSettings()
    {
        var enabledKeys = await JS.InvokeAsync<List<string>>("columnStorage.load", StorageKey);

        // First time → no storage → keep all columns checked
        if (enabledKeys == null)
            return;

        // If saved list exists → apply
        foreach (var col in _columns)
            col.Visible = enabledKeys.Contains(col.Key);
    }
    private async Task SaveColumnSettings()
    {
        var enabledKeys = _columns
            .Where(x => x.Visible)
            .Select(x => x.Key)
            .ToList();

        await JS.InvokeVoidAsync("columnStorage.save", StorageKey, enabledKeys);
    }



    private async Task LoadColumnSettings()
    {
        var enabledKeys = await JS.InvokeAsync<List<string>>("columnStorage.load", StorageKey);

        if (enabledKeys == null)
            return;

        foreach (var col in _columns)
            col.Visible = enabledKeys.Contains(col.Key);
    }



}