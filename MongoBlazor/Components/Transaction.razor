@page "/transactions"
@using MongoBlazor.Model
@using MongoBlazor.Services
@using MudBlazor
@inject TransactionService TransactionService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IDialogService DialogService

<MudPaper Class="pa-4" Style="max-width:1400px;margin:auto;">
    <MudCard Class="pa-3 mb-3">

        <!-- TOOLBAR -->
        <MudStack Row Spacing="2" AlignItems="AlignItems.Center">

            <MudSpacer />

            <MudTextField @bind-Value="_search"
                          Placeholder="Search Tracking Id"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Class="w-300" />

            <MudSelect T="string" @bind-Value="_filterStatus" Label="Status" Class="w-200">
                <MudSelectItem Value="@("All")">All</MudSelectItem>
                <MudSelectItem Value="@("SUCCESS")">Success</MudSelectItem>
                <MudSelectItem Value="@("FAILURE")">Failure</MudSelectItem>
            </MudSelect>

            <MudDateRangePicker @bind-DateRange="_dateRange" Label="Date Range" />

            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyFilter">Apply</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ClearFilter">Reset</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Success" OnClick="DownloadExcel">Export</MudButton>

        </MudStack>
    </MudCard>

    <MudText Typo="Typo.subtitle2" Class="mb-1">
        Total Records: @_totalCount
    </MudText>

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
    }

    <!-- DATA GRID -->
    <MudTable T="TransactionData"
              Items="@_filteredRecords"
              Dense="true"
              Hover="true"
              Bordered="true"
              Striped="true"
              FixedHeader="true"
              RowsPerPage="20"
              Breakpoint="Breakpoint.Sm">

        <HeaderContent>
            <MudTh>#</MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<TransactionData, object>(x => x.TrackingId)">Tracking Id</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<TransactionData, object>(x => x.Status)">Status</MudTableSortLabel></MudTh>
            <MudTh>Request XML</MudTh>
            <MudTh>Response XML</MudTh>
            <MudTh><MudTableSortLabel InitialDirection="SortDirection.Descending" SortBy="new Func<TransactionData, object>(x => x.RequestDateTime)">Request Time</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<TransactionData, object>(x => x.ResponseDateTime ?? DateTime.MinValue)">Response Time</MudTableSortLabel></MudTh>
            <MudTh>Time Taken</MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<TransactionData, object>(x => x.Timestamp)">Created</MudTableSortLabel></MudTh>
        </HeaderContent>

        <RowTemplate Context="x">
            <MudTd>@(_filteredRecords.IndexOf(x) + 1)</MudTd>
            <MudTd>@x.TrackingId</MudTd>

            <MudTd>
                <MudChip T="string"
                         Color="@(x.Status=="SUCCESS" ? Color.Success : Color.Error)"
                         Variant="Variant.Filled"
                         Size="Size.Small">
                    @x.Status
                </MudChip>
            </MudTd>

            <MudTd>
                <MudButton Variant="Variant.Text" Size="Size.Small"
                           OnClick="@(()=>OpenDialog(x,"Request XML"))">
                    View
                </MudButton>
            </MudTd>

            <MudTd>
                <MudButton Variant="Variant.Text" Size="Size.Small"
                           OnClick="@(()=>OpenDialog(x,"Response XML"))">
                    View
                </MudButton>
            </MudTd>

            <MudTd>@x.RequestDateTime.ToString("dd-MMM-yyyy HH:mm:ss")</MudTd>
            <MudTd>@(x.ResponseDateTime?.ToString("dd-MMM-yyyy HH:mm:ss") ?? "-")</MudTd>
            <MudTd>@x.TimeTaken.ToString(@"hh\:mm\:ss")</MudTd>
            <MudTd>@x.Timestamp.ToString("dd-MMM-yyyy HH:mm:ss")</MudTd>
        </RowTemplate>

        <PagerContent>
            <MudTablePager />
        </PagerContent>

    </MudTable>
</MudPaper>

@code {
    private List<TransactionData> _allRecords = new();
    private List<TransactionData> _filteredRecords = new();
    private int _totalCount;
    private DateRange? _dateRange;
    private string _search = "";
    private string _filterStatus = "All";
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            _isLoading = true;
            StateHasChanged();

            // Load all data from database
            (var data, var total) = await TransactionService.GetTransactionsAsync(
                search: null,
                start: null,
                end: null,
                status: "All",
                page: 1,
                pageSize: 1000, // Load more records for client-side filtering
                sortField: "RequestDateTime",
                sortDesc: true
            );

            _allRecords = data;
            _totalCount = total;

            // Apply initial filter
            ApplyClientSideFilter();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading data: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ApplyFilter()
    {
        await LoadData();
    }

    private void ApplyClientSideFilter()
    {
        _filteredRecords = _allRecords.Where(x =>
        {
            // Search filter
            if (!string.IsNullOrWhiteSpace(_search) &&
                !x.TrackingId.Contains(_search, StringComparison.OrdinalIgnoreCase))
                return false;

            // Status filter
            if (_filterStatus != "All" && x.Status != _filterStatus)
                return false;

            // Date range filter
            if (_dateRange?.Start != null && x.RequestDateTime.Date < _dateRange.Start.Value.Date)
                return false;

            if (_dateRange?.End != null && x.RequestDateTime.Date > _dateRange.End.Value.Date)
                return false;

            return true;
        }).ToList();

        _totalCount = _filteredRecords.Count;
    }

    private async Task ClearFilter()
    {
        _search = "";
        _filterStatus = "All";
        _dateRange = null;

        await LoadData();
    }

    private void OpenDialog(TransactionData item, string title)
    {
        var parameters = new DialogParameters
        {
            ["Transaction"] = item,
            ["XmlType"] = title
        };
        DialogService.Show<XmlViewerDialog>(title, parameters);
    }

    private async Task DownloadExcel()
    {
        try
        {
            var rows = await TransactionService.GetAllForExportAsync(
                string.IsNullOrWhiteSpace(_search) ? null : _search,
                _dateRange?.Start,
                _dateRange?.End,
                _filterStatus);

            using var wb = new ClosedXML.Excel.XLWorkbook();
            var ws = wb.Worksheets.Add("Transactions");

            // Headers
            ws.Cell(1, 1).Value = "No";
            ws.Cell(1, 2).Value = "TrackingId";
            ws.Cell(1, 3).Value = "Status";
            ws.Cell(1, 4).Value = "RequestDateTime";
            ws.Cell(1, 5).Value = "ResponseDateTime";
            ws.Cell(1, 6).Value = "TimeTaken";
            ws.Cell(1, 7).Value = "CreatedDate";
            ws.Cell(1, 8).Value = "Message";

            // Style header row
            var headerRow = ws.Row(1);
            headerRow.Style.Font.Bold = true;
            headerRow.Style.Fill.BackgroundColor = ClosedXML.Excel.XLColor.LightGray;

            // Data rows
            for (int i = 0; i < rows.Count; i++)
            {
                var r = rows[i];
                ws.Cell(i + 2, 1).Value = i + 1;
                ws.Cell(i + 2, 2).Value = r.TrackingId;
                ws.Cell(i + 2, 3).Value = r.Status;
                ws.Cell(i + 2, 4).Value = r.RequestDateTime;
                ws.Cell(i + 2, 5).Value = r.ResponseDateTime;
                ws.Cell(i + 2, 6).Value = r.TimeTaken.ToString();
                ws.Cell(i + 2, 7).Value = r.Timestamp;
                ws.Cell(i + 2, 8).Value = r.Message;
            }

            // Auto-fit columns
            ws.Columns().AdjustToContents();

            using var ms = new MemoryStream();
            wb.SaveAs(ms);
            var base64 = Convert.ToBase64String(ms.ToArray());

            await JS.InvokeVoidAsync("downloadFileFromStream",
                $"Transactions_{DateTime.Now:yyyyMMddHHmmss}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                base64);

            Snackbar.Add($"Exported {rows.Count} records successfully", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Export failed: {ex.Message}", Severity.Error);
        }
    }
}