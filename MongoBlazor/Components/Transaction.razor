@page "/transactions"
@using MongoBlazor.Model
@using MongoBlazor.Services
@using MudBlazor
@inject TransactionService TransactionService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IDialogService DialogService

<MudPaper Class="pa-4" Style="max-width:1400px;margin:auto;">
    <MudCard Class="pa-3 mb-3">

        <!-- TOOLBAR -->
        <MudStack Row Spacing="2" >

            <MudText Typo="Typo.h5" Class="fw-bold">Transaction Monitor</MudText>

            <MudSpacer />

            <MudTextField @bind-Value="_search"
                          Placeholder="Search Tracking Id / Message"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Class="w-300"
                          OnInput="@( (string _) => ApplyFilter() )" />

            <MudSelect T="string" Label="Status" @bind-Value="_filter.Status" Class="w-200">
               @*  <MudSelectItem Value="All">All</MudSelectItem>
                <MudSelectItem Value="Success">Success</MudSelectItem>
                <MudSelectItem Value="Failure">Failure</MudSelectItem> *@
            </MudSelect>

            <MudDateRangePicker @bind-DateRange="_dateRange" Label="Date Range" />

            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyFilter">Apply</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ClearFilter">Reset</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Success" OnClick="DownloadExcel">Export</MudButton>

        </MudStack>
    </MudCard>

    <MudText Typo="Typo.subtitle2" Class="mb-1">
        Total Records: @_totalCount
    </MudText>

    <!-- DATA GRID -->
    <MudTable T="TransactionData"
              @ref="_table"
              @* ServerData="LoadServerData" *@
              Items="_records"
              Dense="true"
              Hover="true"
              Bordered="true"
              Striped="true"
              FixedHeader="true"
              RowsPerPage="20"
              Breakpoint="Breakpoint.Sm">


        <HeaderContent>
            <MudTh>#</MudTh>
            <MudTh SortLabel="TrackingId">Tracking Id</MudTh>
            <MudTh SortLabel="Status">Status</MudTh>
            <MudTh>Request XML</MudTh>
            <MudTh>Response XML</MudTh>
            <MudTh SortLabel="RequestDateTime">Request Time</MudTh>
            <MudTh SortLabel="ResponseDateTime">Response Time</MudTh>
            <MudTh>Time Taken</MudTh>
            <MudTh SortLabel="Timestamp">Created</MudTh>
        </HeaderContent>

        <RowTemplate Context="x">
            <MudTd>@(++_rowIndex)</MudTd>
            <MudTd>@x.TrackingId</MudTd>

            <MudTd>
                <MudChip T="string"
                         Color="@(x.Status=="SUCCESS" ? Color.Success : Color.Error)"
                         Variant="Variant.Filled"
                         Size="Size.Small">
                    @x.Status
                </MudChip>
            </MudTd>

            <MudTd>
                <MudButton Variant="Variant.Text" Size="Size.Small"
                         >
                    View
                </MudButton>
            </MudTd>

            <MudTd>
                <MudButton Variant="Variant.Text" Size="Size.Small" >
                           @* OnClick="@(()=>OpenDialog(x,"Response XML"))"> *@
                    View
                </MudButton>
            </MudTd>

            <MudTd>@x.RequestDateTime:dd-MMM-yyyy HH:mm:ss</MudTd>
            <MudTd>@x.ResponseDateTime?.ToString("dd-MMM-yyyy HH:mm:ss")</MudTd>
            <MudTd>@x.TimeTaken</MudTd>
            <MudTd>@x.Timestamp:dd-MMM-yyyy HH:mm:ss</MudTd>
        </RowTemplate>

        <PagerContent>
            <MudTablePager />
        </PagerContent>

    </MudTable>
</MudPaper>

@code {
    private List<TransactionData> _records = new();
    private int _totalCount;

    private DateRange? _dateRange;
    private string _search = "";
    private int _rowIndex = 0;

    private class FilterModel
    {
        public string TrackingId { get; set; }
        public DateTime? StartDate { get; set; }
        public DateTime? EndDate { get; set; }
        public string Status { get; set; } = "All";
    }
    protected override async Task OnInitializedAsync()
    {
        (var data, var total) = await TransactionService.GetTransactionsAsync(
            null, null, null, "All", 1, 200);

        _records = data;
        _totalCount = total;
    }

    private FilterModel _filter = new();

   
    private Task ClearFilter()
    {
        _filter = new();
        _search = "";
        _dateRange = null;
        return ApplyFilter();
    }

    private async Task<TableData<TransactionData>> LoadServerData(
        TableState state,
        CancellationToken token)
    {
        _rowIndex = state.Page * state.PageSize;

        var sortField = state.SortLabel ?? "RequestDateTime";
        var sortDesc = state.SortDirection == SortDirection.Descending;

        (List<TransactionData> records, int total) =
            await TransactionService.GetTransactionsAsync(
                _search,
                _dateRange?.Start,
                _dateRange?.End,
                _filter.Status,
                state.Page + 1,
                state.PageSize,
                sortField,
                sortDesc
            );

        _records = records;
        _totalCount = total;

        return new TableData<TransactionData>
        {
            Items = _records,
            TotalItems = _totalCount
        };
    }
    private async Task ApplyFilter()
    {
        if (_table != null)
            await _table.ReloadServerData();
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _table != null)
            await _table.ReloadServerData();
    }
    private void OpenDialog(TransactionData item, string title)
    {
        var p = new DialogParameters { ["_data"] = item };
        DialogService.Show<XmlViewerDialog>(title, p);
    }

    private async Task DownloadExcel()
    {
        try
        {
            var rows = await TransactionService.GetAllForExportAsync(
                _search, _dateRange?.Start, _dateRange?.End, _filter.Status);

            using var wb = new ClosedXML.Excel.XLWorkbook();
            var ws = wb.Worksheets.Add("Transactions");

            ws.Cell(1, 1).Value = "No";
            ws.Cell(1, 2).Value = "TrackingId";
            ws.Cell(1, 3).Value = "Status";
            ws.Cell(1, 4).Value = "RequestDateTime";
            ws.Cell(1, 5).Value = "ResponseDateTime";
            ws.Cell(1, 6).Value = "TimeTaken";
            ws.Cell(1, 7).Value = "CreatedDate";
            ws.Cell(1, 8).Value = "Message";

            for (int i = 0; i < rows.Count; i++)
            {
                var r = rows[i];
                ws.Cell(i + 2, 1).Value = i + 1;
                ws.Cell(i + 2, 2).Value = r.TrackingId;
                ws.Cell(i + 2, 3).Value = r.Status;
                ws.Cell(i + 2, 4).Value = r.RequestDateTime;
                ws.Cell(i + 2, 5).Value = r.ResponseDateTime;
                ws.Cell(i + 2, 6).Value = r.TimeTaken;
                ws.Cell(i + 2, 7).Value = r.Timestamp;
                ws.Cell(i + 2, 8).Value = r.Message;
            }

            using var ms = new MemoryStream();
            wb.SaveAs(ms);
            var base64 = Convert.ToBase64String(ms.ToArray());

            await JS.InvokeVoidAsync("downloadFileFromStream",
                $"Transactions_{DateTime.Now:yyyyMMddHHmmss}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                base64);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Export failed: {ex.Message}", Severity.Error);
        }
    }

    private MudTable<TransactionData>? _table;
}
