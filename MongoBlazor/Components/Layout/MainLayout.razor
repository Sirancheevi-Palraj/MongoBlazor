@inherits LayoutComponentBase
@using MudBlazor
@using MongoBlazor.Services
@using MongoBlazor.Model
@inject SessionService SessionService
@inject NavigationManager Navigation
@inject AuthService AuthService

<MudThemeProvider IsDarkMode="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>
    <main>
        <div class="top-row px-4">
            <MudStack Row Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Style="width: 100%;">
                @if (AuthService.IsLoginEnabled && _currentUser != null)
                {
                    <MudSpacer />
                    <MudText Typo="Typo.body2" Class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="mr-1" />
                        <strong>@_currentUser.FullName</strong>
                        <MudText Typo="Typo.body2" Class="mx-2" Color="Color.Secondary">
                            (@_currentUser.Role)
                        </MudText>
                    </MudText>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.Logout"
                               OnClick="Logout"
                               Size="Size.Small">
                        Logout
                    </MudButton>
                }
                else if (!AuthService.IsLoginEnabled)
                {
                    <MudSpacer />
                    <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
                }
            </MudStack>
        </div>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private UserSession? _currentUser;

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsLoginEnabled)
        {
            _currentUser = await SessionService.GetSessionAsync();

            // If no session, redirect to login
            if (_currentUser == null)
            {
                Navigation.NavigateTo("/login", true);
            }
        }
    }

    private async Task Logout()
    {
        await SessionService.ClearSessionAsync();
        Navigation.NavigateTo("/login", true);
    }
}