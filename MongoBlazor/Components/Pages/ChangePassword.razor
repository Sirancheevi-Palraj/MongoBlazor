@page "/change-password"
@using MongoBlazor.Model
@using MongoBlazor.Services
@using MudBlazor
@inject UserService UserService
@inject ISnackbar Snackbar

<MudPaper Class="pa-5" Style="max-width:600px;margin:auto;">

    <MudText Typo="Typo.h5" Class="mb-3">Change Password</MudText>

    <MudTextField Label="Username"
                  @bind-Value="_model.Username"
                  Required="true"
                  Class="mb-3" />

    <MudTextField Label="Old Password"
                  @bind-Value="_model.OldPassword"
                  InputType="InputType.Password"
                  Required="true"
                  Class="mb-3" />

    <MudTextField Label="New Password"
                  @bind-Value="_model.NewPassword"
                  InputType="InputType.Password"
                  Required="true"
                  Class="mb-3" />

    <MudTextField Label="Confirm Password"
                  @bind-Value="_model.ConfirmPassword"
                  InputType="InputType.Password"
                  Required="true"
                  Class="mb-4" />

    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ChangePasswords">
        Update Password
    </MudButton>

</MudPaper>

@code {
    private ChangePasswordModel _model = new();

    private async Task ChangePasswords()
    {
        if (string.IsNullOrWhiteSpace(_model.Username))
        {
            Snackbar.Add("Username is required", Severity.Error);
            return;
        }

        if (string.IsNullOrWhiteSpace(_model.OldPassword))
        {
            Snackbar.Add("Old password is required", Severity.Error);
            return;
        }

        if (string.IsNullOrWhiteSpace(_model.NewPassword))
        {
            Snackbar.Add("New password is required", Severity.Error);
            return;
        }

        if (_model.NewPassword != _model.ConfirmPassword)
        {
            Snackbar.Add("New password and Confirm password do not match", Severity.Error);
            return;
        }

        var ok = await UserService.ChangePasswordByUsernameAsync(
            _model.Username.Trim(),
            _model.OldPassword,
            _model.NewPassword);

        if (!ok)
        {
            Snackbar.Add("Invalid username or old password", Severity.Error);
            return;
        }

        Snackbar.Add("Password updated successfully", Severity.Success);

        // clear fields
        _model.OldPassword = "";
        _model.NewPassword = "";
        _model.ConfirmPassword = "";
    }
}
